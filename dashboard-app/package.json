{
  "name": "a11yscan-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:public": "cd public-website && npm run dev",
    "dev:both": "npm-run-all --parallel dev dev:public",
    "build": "next build 2>&1 | tee build.log",
    "build:main": "next build",
    "build:public": "cd public-website && npm run build",
    "export:main": "next build",
    "export:public": "cd public-website && npm run export",
    "start": "next start",
    "studio": "bash -lc 'set -a && [ -f .env ] && source .env; [ -f .env.local ] && source .env.local; set +a && prisma studio --schema prisma/schema.prisma --port 5557'",
    "prisma:studio": "bash -lc 'set -a && [ -f .env ] && source .env; [ -f .env.local ] && source .env.local; set +a && prisma studio --schema prisma/schema.prisma --port 5557'",
    "prisma:generate": "bash -lc 'set -a && [ -f .env ] && source .env; [ -f .env.local ] && source .env.local; set +a && prisma generate --schema prisma/schema.prisma'",
    "dev:emulators": "firebase emulators:start --only firestore,storage,functions,auth --import=./emulator-data --export-on-exit=./emulator-data",
    "deploy:main": "npm run export:main && firebase deploy --only hosting:main-app",
    "deploy:public": "npm run export:public && firebase deploy --only hosting:public-website",
    "deploy:backend": "firebase deploy --only functions,firestore:rules,storage:rules",
    "deploy:all": "npm run export:main && npm run export:public && firebase deploy",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/pubsub": "^5.2.0",
    "@prisma/client": "^5.22.0",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@vercel/speed-insights": "^1.3.1",
    "@wapisgroup/accessibility-rules": "^1.0.5",
    "axe-core": "^4.10.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.9",
    "firebase": "^9.22.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.0.5",
    "mermaid": "^11.12.2",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^5.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.3.0",
    "styled-components": "^6.3.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "firebase-tools": "^15.5.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
